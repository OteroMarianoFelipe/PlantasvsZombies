import wollok.game.*
import jardin.*

class DisparoGuisante {
  var property position = game.at(0, 0)
  var property zombieObjetivo = null
  var property plantaDisparadora = null
  var property activo = false

  method image() = "guisanteDisparo-tablero.png"

  method disparar(zombie, lanzaguisantes) {
    if (!activo and zombie.estaVivo()) {
      zombieObjetivo = zombie
      plantaDisparadora = lanzaguisantes
      position = game.at(lanzaguisantes.position().x() + 1, lanzaguisantes.position().y())
      activo = true
      game.addVisual(self)
    }
  }

  method avanzar() {
    if (activo) {
      if (!zombieObjetivo.estaVivo()) {
        self.retirar()
      } else if (position.x() >= zombieObjetivo.position().x()) {
        plantaDisparadora.modelo().atacar(zombieObjetivo)
        self.retirar()
      } else {
        position = position.right(1)
      }
    }
  }

  method retirar() {
    game.removeVisual(self)
    activo = false
  }
}

const disparoFila1 = new DisparoGuisante()
const disparoFila4 = new DisparoGuisante()

object lanzaguisantesFila1 {
  var property position = game.at(4, 3)
  const entidad = new Lanzaguisantes()

  method image() = "lanzaguisantes-tablero.png"
  method modelo() = entidad
  method estaViva() = entidad.estaViva()

  method recibirDanio(cantidad) {
    entidad.recibirDanio(cantidad)
    if (!entidad.estaViva()) game.removeVisual(self)
  }

  method disparar(zombie) {
    if (entidad.estaViva() and zombie.estaVivo()) disparoFila1.disparar(zombie, self)
  }
}

object girasolFila2 {
  var property position = game.at(4, 4)
  const entidad = new Girasol()

  method image() = "girasol-tablero.png"
  method modelo() = entidad
  method estaViva() = entidad.estaViva()

  method recibirDanio(cantidad) {
    entidad.recibirDanio(cantidad)
    if (!entidad.estaViva()) game.removeVisual(self)
  }
}

object nuezFila3 {
  var property position = game.at(4, 5)
  const entidad = new Nuez()

  method image() = "nuez-tablero.png"
  method modelo() = entidad
  method estaViva() = entidad.estaViva()

  method recibirDanio(cantidad) {
    entidad.recibirDanio(cantidad)
    if (!entidad.estaViva()) game.removeVisual(self)
  }
}

object lanzaguisantesFila4 {
  var property position = game.at(4, 6)
  const entidad = new Lanzaguisantes()

  method image() = "lanzaguisantes-tablero.png"
  method modelo() = entidad
  method estaViva() = entidad.estaViva()

  method recibirDanio(cantidad) {
    entidad.recibirDanio(cantidad)
    if (!entidad.estaViva()) game.removeVisual(self)
  }

  method disparar(zombie) {
    if (entidad.estaViva() and zombie.estaVivo()) disparoFila4.disparar(zombie, self)
  }
}

object girasolFila5 {
  var property position = game.at(4, 7)
  const entidad = new Girasol()

  method image() = "girasol-tablero.png"
  method modelo() = entidad
  method estaViva() = entidad.estaViva()

  method recibirDanio(cantidad) {
    entidad.recibirDanio(cantidad)
    if (!entidad.estaViva()) game.removeVisual(self)
  }
}

class ZombieVisual {
  var property position = game.at(14, 3)
  const property plantaObjetivo
  const entidad = new Zombie()

  method image() = "zombie-tablero.png"
  method modelo() = entidad
  method estaVivo() = entidad.estaVivo()

  method recibirDanio(cantidad) {
    entidad.recibirDanio(cantidad)
    if (!entidad.estaVivo()) game.removeVisual(self)
  }

  method avanzar() {
    if (self.estaVivo()) {
      if (plantaObjetivo.estaViva() and position.x() > plantaObjetivo.position().x() + 1) {
        position = position.left(1)
      } else if (plantaObjetivo.estaViva()) {
        entidad.atacar(plantaObjetivo)
      } else if (position.x() > 0) {
        position = position.left(1)
      }
    }
  }
}

const zombieFila1 = new ZombieVisual(position = game.at(14, 3), plantaObjetivo = lanzaguisantesFila1)
const zombieFila2 = new ZombieVisual(position = game.at(14, 4), plantaObjetivo = girasolFila2)
const zombieFila3 = new ZombieVisual(position = game.at(14, 5), plantaObjetivo = nuezFila3)
const zombieFila4 = new ZombieVisual(position = game.at(14, 6), plantaObjetivo = lanzaguisantesFila4)
const zombieFila5 = new ZombieVisual(position = game.at(14, 7), plantaObjetivo = girasolFila5)
const zombies = [zombieFila1, zombieFila2, zombieFila3, zombieFila4, zombieFila5]

program juego {
  game.title("Line Defense - Plants vs Zombies")
  game.height(11)
  game.width(20)
  game.cellSize(30)
  game.boardGround("jardin.png")

  game.addVisual(lanzaguisantesFila1)
  game.addVisual(girasolFila2)
  game.addVisual(nuezFila3)
  game.addVisual(lanzaguisantesFila4)
  game.addVisual(girasolFila5)
  zombies.forEach({ zombie => game.addVisual(zombie) })

  game.onTick(1200, "moverZombies", {
    zombies.forEach({ zombie => zombie.avanzar() })
  })

  game.onTick(100, "moverDisparos", {
    disparoFila1.avanzar()
    disparoFila4.avanzar()
  })

  game.onTick(4000, "dispararFila1", {
    if (zombieFila1.position().x() > lanzaguisantesFila1.position().x()) {
      lanzaguisantesFila1.disparar(zombieFila1)
    }
  })

  game.onTick(4000, "dispararFila4", {
    if (zombieFila4.position().x() > lanzaguisantesFila4.position().x()) {
      lanzaguisantesFila4.disparar(zombieFila4)
    }
  })

  game.start()
}
