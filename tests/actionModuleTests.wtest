import entity.*
import entityManager.*
import imageProvider.*
import zombies.zombieBasico.*
import plantas.nuez.*
import plantas.girasol.*
import proyectiles.pea.*
import util.config.*

describe "Módulo de acción: zombies"{

    method initialize(){
        game.width(config.width())
        game.height(config.height())
    }

    method tickear(entidad, veces){ veces.times({ i => entidad.tick() }) }

    method nuevoZombie(pos){
        const zombie = new ZombieBasico()
        zombie.start(pos)
        return zombie
    }

    test "Un zombie ataca a la planta con la que choca (una vez por segundo)"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Nuez()
        planta.start(game.at(5, 2))
        const zombie = self.nuevoZombie(game.at(5, 2))

        self.tickear(zombie, 5)
        assert.equals(planta.startingHealth(), planta.health())

        self.tickear(zombie, 1)
        assert.equals(planta.startingHealth() - 100, planta.health())
    }

    test "Un zombie no avanza mientras tenga una planta en su celda"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Nuez()
        planta.start(game.at(5, 2))
        const zombie = self.nuevoZombie(game.at(5, 2))
        self.tickear(zombie, 30)
        assert.equals(game.at(5, 2), zombie.position())
    }

    test "Un zombie sin obstáculos avanza hacia la izquierda"{
        entitiesMap.initializeEntitiesMap()
        const zombie = self.nuevoZombie(game.at(8, 2))
        self.tickear(zombie, 24)
        assert.equals(game.at(7, 2), zombie.position())
        assert.that(game.hasVisual(zombie))
    }

    test "Un zombie sigue avanzando después de comerse a la planta"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Girasol()
        planta.start(game.at(8, 2))
        const zombie = self.nuevoZombie(game.at(8, 2))
        self.tickear(zombie, 60)
        assert.that(not planta.lives())
        assert.that(zombie.position().x() < 8)
    }
}


describe "Módulo de acción: base"{

    method initialize(){
        game.width(config.width())
        game.height(config.height())
    }

    test "El módulo le pasa a sus partes las entidades con las que choca, una sola vez por tick"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Nuez()
        planta.start(game.at(5, 2))
        const zombie = new ZombieBasico()
        zombie.start(game.at(5, 2))
        const consultas = []
        const modulo = object inherits ActionModule{
            override method act(user, touching){ consultas.add(touching) }
        }

        modulo.use(planta)

        assert.equals([[zombie]], consultas)
    }
    
    test "Un módulo detenido no actúa"{
        entitiesMap.initializeEntitiesMap()
        const zombie = new ZombieBasico()
        zombie.start(game.at(8, 2))

        zombie.actionModule().stop()
        30.times({ i => zombie.tick() })

        assert.equals(game.at(8, 2), zombie.position())
    }
}


// Una parte de prueba. registra cada vez que el modulo llega hasta ella
mixin ParteQueRegistra{
    const property veces = []

    override method act(user, touching){
        super(user, touching)
        veces.add("actuó")
    }
}

describe "Módulo de acción: HandlesCollisions"{

    method initialize(){
        game.width(config.width())
        game.height(config.height())
    }

    method nuevoZombie(pos){
        const zombie = new ZombieBasico()
        zombie.start(pos)
        return zombie
    }

    test "Le avisa a la entidad con quién chocó"{
        entitiesMap.initializeEntitiesMap()
        const zombie = self.nuevoZombie(game.at(5, 2))
        const choques = []
        const entidad = object {
            method position() = game.at(5, 2)
            method collisionHandler(otra){ choques.add(otra) }
        }
        const modulo = object inherits HandlesCollisions and ActionModule{}

        modulo.use(entidad)

        assert.equals([zombie], choques)
    }

    test "Si manejar una colisión detiene el módulo, ignora el resto de las colisiones y de las acciones"{
        entitiesMap.initializeEntitiesMap()
        self.nuevoZombie(game.at(5, 2))
        self.nuevoZombie(game.at(5, 2))
        const choques = []
        const modulo = object inherits HandlesCollisions and ParteQueRegistra and ActionModule{}
        const entidad = object {
            method position() = game.at(5, 2)
            method collisionHandler(otra){ choques.add(otra) modulo.stop() }
        }

        modulo.use(entidad)

        assert.equals(1, choques.size())
        assert.equals([], modulo.veces())
    }

    test "Si no se detiene el módulo, después de manejar las colisiones sigue con el resto de las acciones"{
        entitiesMap.initializeEntitiesMap()
        self.nuevoZombie(game.at(5, 2))
        const modulo = object inherits HandlesCollisions and ParteQueRegistra and ActionModule{}
        const entidad = object {
            method position() = game.at(5, 2)
            method collisionHandler(otra){}
        }

        modulo.use(entidad)

        assert.equals(["actuó"], modulo.veces())
    }
}

describe "Módulo de acción: ralentizar"{

    method initialize(){
        game.width(config.width())
        game.height(config.height())
    }

    method tickear(entidad, veces){ veces.times({ i => entidad.tick() }) }

    method nuevoZombie(pos){
        const zombie = new ZombieBasico()
        zombie.start(pos)
        return zombie
    }

    test "Un módulo ralentizado se mueve más lento"{
        entitiesMap.initializeEntitiesMap()
        const zombie = self.nuevoZombie(game.at(8, 2))
        zombie.actionModule().slowDown(2)

        self.tickear(zombie, 30)
        assert.equals(game.at(8, 2), zombie.position())

        self.tickear(zombie, 20)
        assert.equals(game.at(7, 2), zombie.position())
    }

    test "Al restaurar la velocidad el módulo se mueve a su ritmo normal sin perder el tiempo acumulado"{
        entitiesMap.initializeEntitiesMap()
        const zombie = self.nuevoZombie(game.at(8, 2))
        zombie.actionModule().slowDown(2)
        self.tickear(zombie, 10)

        zombie.actionModule().restoreSpeed()

        self.tickear(zombie, 13)
        assert.equals(game.at(8, 2), zombie.position())
        self.tickear(zombie, 1)
        assert.equals(game.at(7, 2), zombie.position())
    }

    
    method nuevoModuloDeDisparo(disparos){
        return object inherits UnconditionalShooter(
            shotsPerSecond = 1,                                                   // 5 ticks
            proyectileGenerator = { user => object { method start(pos){ disparos.add(pos) } } },
            shootingAnticipationAnimation = noImageProvider
        ) and ActionModule{}
    }

    test "Un módulo de disparo ralentizado dispara con más tiempo entre disparo y disparo"{
        entitiesMap.initializeEntitiesMap()
        const disparos = []
        const modulo = self.nuevoModuloDeDisparo(disparos)
        const entidad = object { method position() = game.at(5, 2) }

        modulo.slowDown(2)                                                        // ahora 10 ticks
        10.times({ i => modulo.use(entidad) })
        assert.equals(0, disparos.size())

        modulo.use(entidad)
        assert.equals(1, disparos.size())
    }

    test "Al restaurar la velocidad un módulo de disparo vuelve a disparar en su tiempo normal"{
        entitiesMap.initializeEntitiesMap()
        const disparos = []
        const modulo = self.nuevoModuloDeDisparo(disparos)
        const entidad = object { method position() = game.at(5, 2) }

        modulo.slowDown(2)
        7.times({ i => modulo.use(entidad) })

        modulo.restoreSpeed()                                                     // vuelve a 5 ticks: ya se pasó
        modulo.use(entidad)
        assert.equals(1, disparos.size())
    }

    test "Un zombie ralentizado ataca con más tiempo entre ataque y ataque"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Nuez()
        planta.start(game.at(5, 2))
        const zombie = self.nuevoZombie(game.at(5, 2))

        zombie.actionModule().slowDown(2)                                         // ahora 2 segundos entre ataques
        self.tickear(zombie, 10)
        assert.equals(planta.startingHealth(), planta.health())

        self.tickear(zombie, 1)
        assert.equals(planta.startingHealth() - 100, planta.health())
    }

    test "Al restaurar la velocidad un zombie vuelve a atacar en su tiempo normal"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Nuez()
        planta.start(game.at(5, 2))
        const zombie = self.nuevoZombie(game.at(5, 2))

        zombie.actionModule().slowDown(2)
        self.tickear(zombie, 7)

        zombie.actionModule().restoreSpeed()                                      // vuelve a 1 segundo: ya se pasó
        self.tickear(zombie, 1)
        assert.equals(planta.startingHealth() - 100, planta.health())
    }
}

describe "Proyectiles: arvejas"{

    method initialize(){
        game.width(config.width())
        game.height(config.height())
    }

    method tickear(entidad, veces){ veces.times({ i => entidad.tick() }) }

    method nuevaArveja(pos){
        const arveja = new Pea(team = "PLANTAS", damage = 20, frozen = false)
        arveja.start(pos)
        return arveja
    }

    method nuevoZombie(pos){
        const zombie = new ZombieBasico()
        zombie.start(pos)
        return zombie
    }

    test "Una arveja avanza una celda por tick"{
        entitiesMap.initializeEntitiesMap()
        const arveja = self.nuevaArveja(game.at(3, 2))
        arveja.tick()
        assert.equals(game.at(4, 2), arveja.position())
        assert.that(game.hasVisual(arveja))
    }

    test "Una arveja que sale del tablero se elimina"{
        entitiesMap.initializeEntitiesMap()
        const arveja = self.nuevaArveja(game.at(config.width() - 2, 2))
        arveja.tick()
        assert.that(game.hasVisual(arveja))
        arveja.tick()
        assert.notThat(game.hasVisual(arveja))
    }

    test "Una arveja daña a un zombie cuando choca con él"{
        entitiesMap.initializeEntitiesMap()
        const zombie = self.nuevoZombie(game.at(5, 2))
        const arveja = self.nuevaArveja(game.at(4, 2))
        self.tickear(arveja, 2)
        assert.equals(zombie.startingHealth() - 20, zombie.health())
    }

    test "Después de chocar la arveja deja de actuar: ni avanza ni vuelve a dañar"{
        entitiesMap.initializeEntitiesMap()
        const zombie = self.nuevoZombie(game.at(5, 2))
        const arveja = self.nuevaArveja(game.at(4, 2))
        self.tickear(arveja, 6)
        assert.equals(game.at(5, 2), arveja.position())
        assert.equals(zombie.startingHealth() - 20, zombie.health())
    }

    test "Una arveja solo daña a un zombie aunque haya dos en la misma celda"{
        entitiesMap.initializeEntitiesMap()
        const zombie1 = self.nuevoZombie(game.at(5, 2))
        const zombie2 = self.nuevoZombie(game.at(5, 2))
        const arveja = self.nuevaArveja(game.at(4, 2))
        self.tickear(arveja, 3)
        const danioTotal = (zombie1.startingHealth() - zombie1.health()) + (zombie2.startingHealth() - zombie2.health())
        assert.equals(20, danioTotal)
    }

    test "Una arveja no daña a las plantas"{
        entitiesMap.initializeEntitiesMap()
        const planta = new Nuez()
        planta.start(game.at(5, 2))
        const arveja = self.nuevaArveja(game.at(4, 2))
        self.tickear(arveja, 3)
        assert.equals(planta.startingHealth(), planta.health())
    }
}