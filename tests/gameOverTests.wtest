import entityTickingManager.*
import spawning.*
import zombies.zombieBasico.*
import plantas.nuez.*
import UIElements.gameOver.*
import util.config.*
import wollok.mirror.*

const entityTickingManagerMirror = new ObjectMirror(target = entityTickingManager)

describe "Perder la partida"{


    method initialize(){
        game.width(config.width())
        game.height(config.height())
    }

    test "Al perder se eliminan las visuales de todas las entidades"{
        const zombie = new ZombieBasico()
        zombie.start(game.at(5, 2))
        const planta = new Nuez()
        planta.start(game.at(3, 2))

        config.lose()

        assert.notThat(game.hasVisual(zombie))
        assert.notThat(game.hasVisual(planta))
    }

    test "Al perder aparece la pantalla de game over"{

        config.lose()

        assert.that(game.hasVisual(gameOver))
    }

    test "Al perder se frenan los ticks de las entidades"{
        entityTickingManager.startTicking()

        config.lose()

        assert.notThat(io.containsTimeEvent("tickEntities"))
        assert.notThat(io.containsTimeEvent("AnimateEntities"))
    }
}