import behavior.*

// Un comportamiento de prueba que cuenta cuántas veces se activó
class ComportamientoDePrueba inherits Behavior{
    var property activaciones = 0

    override method activate(user){ activaciones += 1 }
}

describe "Behavior"{

    method usar(comportamiento, veces){
        veces.times({ i => comportamiento.use(null) })
    }

    test "Se activa cuando termina su tiempo de espera"{
        const comportamiento = new ComportamientoDePrueba(secondsPerUse = 1)   // 5 ticks
        self.usar(comportamiento, 5)
        assert.equals(0, comportamiento.activaciones())
        self.usar(comportamiento, 1)
        assert.equals(1, comportamiento.activaciones())
    }

    test "Si su tiempo de espera se acorta mientras esperaba, se activa igual aunque ya se haya pasado"{
        const comportamiento = new ComportamientoDePrueba(secondsPerUse = 1)   // 5 ticks
        self.usar(comportamiento, 3)
        comportamiento.secondsPerUse(0.2)                                        // ahora 1 tick: ya se pasó
        self.usar(comportamiento, 1)
        assert.equals(1, comportamiento.activaciones())
    }

    test "Un comportamiento ralentizado tarda más en activarse"{
        const comportamiento = new ComportamientoDePrueba(secondsPerUse = 1)   // 5 ticks
        comportamiento.slowDown(2)                                               // ahora 10 ticks
        self.usar(comportamiento, 10)
        assert.equals(0, comportamiento.activaciones())
        self.usar(comportamiento, 1)
        assert.equals(1, comportamiento.activaciones())
    }

    test "Al ralentizarlo no pierde el tiempo de espera que ya había acumulado"{
        const comportamiento = new ComportamientoDePrueba(secondsPerUse = 1)   // 5 ticks
        self.usar(comportamiento, 3)
        comportamiento.slowDown(2)                                               // ahora 10 ticks en total
        self.usar(comportamiento, 7)
        assert.equals(0, comportamiento.activaciones())
        self.usar(comportamiento, 1)
        assert.equals(1, comportamiento.activaciones())
    }

    test "Al restaurar la velocidad vuelve a activarse en su tiempo normal"{
        const comportamiento = new ComportamientoDePrueba(secondsPerUse = 1)   // 5 ticks
        comportamiento.slowDown(2)
        self.usar(comportamiento, 7)
        comportamiento.restoreSpeed()                                            // vuelve a 5 ticks: ya se pasó
        self.usar(comportamiento, 1)
        assert.equals(1, comportamiento.activaciones())
    }
}