import imageProvider.*
import imageProviderHandler.*
import entity.*
import entityTickingManager.*
import team.*

const proveedorDeEjemplo = new Sprite( image = "" )
const entidadPlana = 
    object inherits Entity(
        imageProviderSet = 
            new ImageProviderSet().initialize([
                    new ImageProviderEntry(
                        key = "#Default",
                        value = proveedorDeEjemplo
                    )
            ]),
        defaultImageProviderKey = "#Default"
    ){}
const entidadViva = 
    object inherits Alive(
        deathHandler = { user => user.dead(true) },
        maxHealth = 200
    ) and Entity(
        imageProviderSet = 
            new ImageProviderSet().initialize([
                new ImageProviderEntry(
                    key = "#Default",
                    value = proveedorDeEjemplo
                )
            ]),
        defaultImageProviderKey = "#Default"
    ){ var property dead = false }

describe "Manejo propio"{
    test "Logra iniciar correctamente"{
        entidadPlana.start(game.at(-33, 99))
        assert.that(game.hasVisual(entidadPlana) && entidadPlana.position() == game.at(-33, 99))
    }
    test "Logra eliminarse correctamente"{
        entidadPlana.start(game.at(0, 0))
        entidadPlana.cleanUp()
        assert.that(not game.hasVisual(entidadPlana))
    }
    test "Logra cambiar su posición correctamente"{
        const nuevaPosición = game.at(2, 2)
        game.addVisual(entidadPlana)
        entidadPlana.position(game.at(3, 3))
        entidadPlana.position(nuevaPosición)
        assert.equals(entidadPlana.position(), nuevaPosición)
        assert.equals([entidadPlana], nuevaPosición.allElements())
        assert.that(nuevaPosición.allElements().contains(entidadPlana))
    }
}
describe "Mensajes de consulta"{
    test "Logra determinar correctamente si una entidad es o no enemiga"{
        const resultadosEsperados = [false, true, false, true, false, false, false, false, false]
        const resultadosObtenidos = []
        const equiposAProbar=[plantsTeam, zombiesTeam, neutralTeam]
        equiposAProbar.forEach({ i =>
            entidadPlana.team(i)
            equiposAProbar.forEach({ t =>
                entidadViva.team(t)
                resultadosObtenidos.add(entidadPlana.isEnemy(entidadViva))
            })
        })
        assert.equals(resultadosEsperados, resultadosObtenidos)
    }
}
describe "Manejo de proveedores de imagen"{ 
    test "Logra cambiar de proveedor de imagen" {
        entidadPlana.imageHandler().imageProvider(noImageProvider)
        assert.equals(noImageProvider, entidadPlana.imageHandler().imageProvider())
    }
}
describe "Entidad viva"{
    test "Recibe la cantidad correcta de daño"{
        entidadViva.health(200)
        entidadViva.takeDamage(100)
        assert.equals(100, entidadViva.health())
    }

    test "Al morir llama a su death handler"{
        entidadViva.health(1)
        entidadViva.takeDamage(1)
        assert.that(entidadViva.dead())
    }
}