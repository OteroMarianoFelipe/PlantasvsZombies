import entityManager.*
import util.config.*

describe "El mapa es inicializado correctamente"{
    test "El mapa vacio tiene la altura correcta"{
        assert.equals(config.height()+1, entitiesMap.emptyEntitiesMap().get(0).size())
    }
    test "El mapa vacio tiene el ancho correcto"{
        assert.equals(config.width()+1, entitiesMap.emptyEntitiesMap().size())
    }
    test "El mapa se inicializa correctamente"{
        entitiesMap.initializeEntitiesMap()
        assert.equals(entitiesMap.emptyEntitiesMap(), entitiesMap.spatialGrid())
    }
}

describe "Operaciónes con effectos sobre el mapa"{
    const entidad1 = object{var property position = game.at(1, 1) var property previousPosition = self.position()}
    const entidad2 = object{var property position = game.at(2, 3) var property previousPosition = self.position()}
    const entidad3 = object{var property position = game.at(5, 7) var property previousPosition = self.position()}

    method inicializarConEntidades(entidades){
        entitiesMap.initializeEntitiesMap()
        entidades.forEach({ e =>
            entitiesMap.add(e)
        })
    }

    test "Agrega una entidad correctamente"{
        self.inicializarConEntidades([entidad1])
        assert.equals(entidad1, entitiesMap.allEntitiesAt(entidad1.position()).get(0))
    }

    test "Remueve correctamente una entidad"{
        self.inicializarConEntidades([entidad2])
        entitiesMap.remove(entidad2)
        assert.equals([], entitiesMap.allEntitiesAt(entidad2.position()))
    }

    test "Logra poner a la entidad en su posición actualizada"{
        self.inicializarConEntidades([entidad3])
        entitiesMap.updatePosition(entidad3)
        assert.equals(entidad3, entitiesMap.allEntitiesAt(entidad3.position()).get(0) )
    }
    test "Borra efectivamente una entidad de una posición previa"{
        self.inicializarConEntidades([entidad2])
        entidad2.position(game.at(2, 7))
        entitiesMap.updatePosition(entidad2)
        assert.equals([], entitiesMap.allEntitiesAt(entidad2.previousPosition()))
    }
}

describe "Mensajes de consulta"{

    const entidad1 = object{var property position = game.at(1, 1) var property previousPosition = self.position()}
    const entidad2 = object{var property position = game.at(1, 1) var property previousPosition = self.position()}

    method inicializarConEntidades(entidades){
        entitiesMap.initializeEntitiesMap()
        entidades.forEach({ e =>
            entitiesMap.add(e)
        })
    }

    method llenarFilaDeEntidades(yLevel){
        (config.width()+1).times({ i => 
            entitiesMap.add(object{
                var property position = game.at(i-1, yLevel)
            })
        })
    }
    method llenarMapaDeEntidades(){
        (config.height()+1).times({ i =>
            self.llenarFilaDeEntidades(i-1)
        })
    }

    test "Devuelve effectivamente todas las entidades en una celda especifica"{
        self.inicializarConEntidades([entidad1, entidad2])
        assert.equals([entidad1, entidad2], entitiesMap.allEntitiesAt(entidad1.position()))
    }

    test "Devuelve effectivamente todas las entidades en una fila especifica"{
        self.inicializarConEntidades([])
        self.llenarMapaDeEntidades()
        assert.equals(config.width()+1, entitiesMap.allEntitiesAtLine(3).size())
    }

    test "Devuelve effectivamente todas las entidades que colisionan con una"{
        self.inicializarConEntidades([])
        3.times({i => self.llenarMapaDeEntidades()})
        assert.equals(3, entitiesMap.allIntersectingEntities(entidad1).size())
    }
}