import wollok.mirror.*
import zombies.coneHead.*
import zombies.zombie.*
import zombies.zombieBasico.*
import imageProvider.*
import entity.*
import util.config.*
import entityTickingManager.*
import plantas.nuez.*
import UIElements.gameOver.*
import actionModule.*
import behavior.*

describe "ZombieBasico"{

    const spy = object {
        var hasBeenCalled = false
        method reciveCall(){ hasBeenCalled = true }
        method hasReceivedCall() = hasBeenCalled
    }

    const zombie = object inherits ZombieBasico{}

    method setUpDeathHandlerCall(){
        zombie.deathHandler({ user => spy.reciveCall() })
    }

    test "Un zombie puede ser congelado"{
        zombie.freeze()
        const zombieMirror = new ObjectMirror(target = zombie)
        assert.that(zombieMirror.resolve("frozen") > 0)
    }

    test "Cuando un zombie cruza el patio se pierde la partida"{
        const planta = new Nuez()
        planta.start(game.at(3, 2))

        zombie.position(game.at(config.lowerBound().x()-1, 2))

        assert.that(game.hasVisual(gameOver))
        assert.notThat(game.hasVisual(planta))
    }

    test "Cuando su vida cae a 0 manejan su propia muerte"{
        self.setUpDeathHandlerCall()
        zombie.takeDamage(zombie.health())
        assert.that(spy.hasReceivedCall())
    }
}