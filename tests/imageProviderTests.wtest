import wollok.mirror.*
import imageProvider.*
import imageProviderHandler.*
import util.config.*

object handler inherits ImageProviderHandler( imageProvider = noImageProvider, user = caller ){}
object handlerMirror inherits ObjectMirror(target = handler){}
const tracker = handlerMirror.resolve("stateTracker")
object caller {
    var endedAnimation = false
    method endedAnimation() = endedAnimation
    method animationEnded(){ endedAnimation = true }
}

describe "Image provider handler"{
    const testingAnimation1 = new Animation(
        family = "zombieWalking",
        durationInSeconds = 9,
        framesInAnimation = 7,
        animationDirectory = "zombies/basic/walkingFH" 
    )
    const testingAnimation2 = new Animation(
        durationInSeconds = 0.5,
        framesInAnimation = 4,
        animationDirectory = "plants/peashooter/active"
    )
    method changeImageProviderTemporarily(handler){
        handler.imageProvider(testingAnimation1)
        tracker.frameNumber(3)
        tracker.ticksInFrame(2)
        handler.useTempAnimation(testingAnimation2, 1)
    }

    test "Cambia efectivamente a un proveedor de imagen temporal"{
        self.changeImageProviderTemporarily(handler)        
        assert.equals(testingAnimation1, handler.imageProvider())
        assert.equals(testingAnimation2, handler.currentProvider())
        assert.equals(1, tracker.ticksInFrame())
        assert.equals(1, tracker.frameNumber())
    }

    test "Transiciona efectivamente toda la animación temporal"{
        self.changeImageProviderTemporarily(handler)        
        handler.currentProvider().framesInAnimation().times({ f =>
            handler.currentProvider().animationTicksPerFrame().times({ t =>
                assert.equals(testingAnimation2 ,handler.currentProvider())
                handler.update() 
            })
        })
        assert.equals(testingAnimation1 ,handler.currentProvider())
    }
    
    test "Cambia de vuelta a su proveedor original una vez se terminan las repeticiones del temporal"{
        self.changeImageProviderTemporarily(handler)
        tracker.frameNumber(handler.currentProvider().framesInAnimation())
        tracker.ticksInFrame(handler.currentProvider().animationTicksPerFrame())
        handler.update()
        assert.equals(testingAnimation1, handlerMirror.resolve("imageProvider"))
        assert.equals(1, tracker.frameNumber())
        assert.equals(1, tracker.ticksInFrame())

    }
}

describe "Animation"{
    const testingAnimation = new Animation(
        family = "zombieWalking",
        durationInSeconds = 9,
        framesInAnimation = 7,
        animationDirectory = "zombies/basic/walkingFH" 
    )

    method setInLastFrame(tracker){ tracker.frameNumber(handler.imageProvider().framesInAnimation()) }

    test "Determina correctamente la cantidad de ticks por frame"{
        const ticksPerFrame = (config.secondsToAnimationTicks(testingAnimation.durationInSeconds())/testingAnimation.framesInAnimation()).truncate(0)
        assert.equals(ticksPerFrame, testingAnimation.animationTicksPerFrame())
    }

    test "Identifica el momento de cambiar pasados los ticks necesarios"{
        tracker.ticksInFrame(testingAnimation.animationTicksPerFrame())
        assert.that(testingAnimation.isTimeToPassFrame(tracker))
    }

    test "Identifica que no debe cambiar a falta de los ticks necesarios"{
        tracker.ticksInFrame(1)
        assert.that(not testingAnimation.isTimeToPassFrame(tracker))
    }

    test "Cambia correctamente los ticks en frame"{
        handler.imageProvider(testingAnimation)
        handler.update()
        assert.equals(2, tracker.ticksInFrame())
    }

    test "Cambia de frame correctamente dentro del rango"{
        const results = []
        const expectedResults = (1 .. testingAnimation.animationTicksPerFrame()-1).map({ i=> 1 }) + [2]
        handler.imageProvider(testingAnimation)
        (testingAnimation.animationTicksPerFrame()).times({ t =>
            handler.update()
            results.add(tracker.frameNumber())
        })
        assert.equals(expectedResults, results)
    }
    test "Cambia al primer frame una vez llegado al final"{
        handler.imageProvider(testingAnimation)
        self.setInLastFrame(tracker)
        tracker.ticksInFrame(handler.imageProvider().animationTicksPerFrame())
        handler.update()
        assert.equals(1, tracker.frameNumber())
    }
    test "Envía la señal una vez terminada la animación"{
        handler.imageProvider(testingAnimation)
        self.setInLastFrame(tracker)
        tracker.ticksInFrame(handler.imageProvider().animationTicksPerFrame())
        handler.update()
        assert.that(caller.endedAnimation())
    }

    test "Devuelve los indices en formato 001 de forma correcta"{
        const resultadosDeReferencia = ["001", "002", "003", "004", "005", "006", "007", "008", "009", "010", "101"]
        const resultadosReales = []
        10.times({ i => 
            resultadosReales.add(testingAnimation.frameNumber001Format(i))
        })
        resultadosReales.add(testingAnimation.frameNumber001Format(101))
        assert.equals(resultadosDeReferencia, resultadosReales)
    }

    test "Devuelve la dirección correcta a la imagen"{
        const direcciónEsperada = "animations/zombies/basic/walkingFH/frame_909.png"
        tracker.frameNumber(909)
        assert.equals(direcciónEsperada, testingAnimation.getImage(caller, tracker))
    }
}

describe "Animacion Estatica"{
    test "Devuelve como dirección a la imagen la dirección asignada"{
        const newImage = new Sprite( image = "Esta es una dirección muy real")
        assert.equals(newImage.image(), newImage.getImage("noUser", "noTraker"))
    }
}

describe "Proveedor de imagen basado en vida"{
    const caller = object{
        var property maxHealth = 300
        var property health = 300

        method animationEnded(){}
        method setHealthPercentage(percentage){
            self.health(self.maxHealth()*percentage)
        }
    }

    const imageProviderSet = [
            new Animation(
                durationInSeconds = 3.14,
                framesInAnimation = 14.5,
                animationDirectory = "A" 
            ),
            new Animation(
                durationInSeconds = 16000000,
                framesInAnimation = 324000,
                animationDirectory = "B" 
            ),
            new Animation(
                durationInSeconds = 0.1,
                framesInAnimation = 0.1,
                animationDirectory = "C" 
            )
        ]

    const healthBasedImageProvider = new HealthBasedImageProvider( imageProviderSet = imageProviderSet )

    test "Devuelve la imagen del proveedor de imagen correcto"{
        const resultadosEsperados = 
            (1 .. imageProviderSet.size()).map({ i =>
                const proveedorDeImagenEsperado = imageProviderSet.get(imageProviderSet.size()-i)
                return proveedorDeImagenEsperado.getImage(caller, tracker)
            })
        const resultadosObtenidos = 
            (1 .. imageProviderSet.size()).map({ i =>
                caller.setHealthPercentage(1/i)
                return healthBasedImageProvider.getImage(caller, tracker)
            })
        assert.equals(resultadosEsperados, resultadosObtenidos)
    }
}